<Project Sdk="Microsoft.NET.Sdk">

  <!--
    sOCScreenShare.exe: la ventana (que grabar, sonido, carpeta y calidad), los botones de grabar,
    pausar y parar, el atajo global, el icono de la bandeja mientras graba, la guia, las novedades,
    «Acerca de» y la linea de ordenes (record/probe). La logica esta en ScreenShare.Core y la
    grabacion en ScreenShare.Engine; aqui solo la interfaz y lo que la engancha a Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>SocScreenShare.App</RootNamespace>
    <AssemblyName>sOCScreenShare</AssemblyName>
    <ApplicationTitle>sOC ScreenShare</ApplicationTitle>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenShare.Core\ScreenShare.Core.csproj" />
    <ProjectReference Include="..\ScreenShare.Engine\ScreenShare.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\tray-recording.png" />
    <Resource Include="appicon.ico" />
  </ItemGroup>

</Project>
