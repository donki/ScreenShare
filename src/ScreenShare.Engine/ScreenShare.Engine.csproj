<Project Sdk="Microsoft.NET.Sdk">

  <!--
    El motor de grabacion, solo con APIs de Windows y bibliotecas MIT: captura de pantallas y
    ventanas con Windows.Graphics.Capture, escalado y paso a NV12 en la tarjeta grafica (Direct3D 11,
    Vortice), MP4 H.264 + AAC con Media Foundation (con el codificador por hardware si lo hay) y el
    audio con WASAPI (NAudio): la salida de un dispositivo, una aplicacion concreta y el microfono.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>SocScreenShare.Engine</RootNamespace>
    <AssemblyName>ScreenShare.Engine</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScreenShare.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenShare.Core\ScreenShare.Core.csproj" />
  </ItemGroup>

</Project>
