<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de interfaz de sOC ScreenShare con FlaUI (MIT) sobre UI Automation (General 8.7). Lanzan
    el exe Debug ya compilado en modo aislado (SOC_SANDBOX): ajustes y videos en una carpeta temporal,
    sin bandeja, sin atajos globales, sin vigilancia de ventanas y sin activar ventanas (no roban el
    foco). Todo va por patrones de UI Automation, sin raton ni teclado. Ver README.md de esta carpeta.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SocScreenShare.UITests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
