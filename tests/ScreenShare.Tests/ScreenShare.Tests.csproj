<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Banco de pruebas de sOC ScreenShare (General 8.6): la logica de ScreenShare.Core y, detras de
    SOC_SCS_INTEGRATION=1, pruebas de integracion del motor que graban de verdad la pantalla un par de
    segundos en una carpeta temporal y usan el programa de prueba propio (sOCScreenShareToneApp).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SocScreenShare.Tests</RootNamespace>
    <AssemblyName>ScreenShare.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenShare.Core\ScreenShare.Core.csproj" />
    <ProjectReference Include="..\..\src\ScreenShare.Engine\ScreenShare.Engine.csproj" />
    <!-- Se compila antes, pero no se enlaza: las pruebas de integracion lo lanzan como proceso. -->
    <ProjectReference Include="..\ScreenShare.ToneApp\ScreenShare.ToneApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
