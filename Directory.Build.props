<Project>
  <!-- Comun a todos los proyectos: version unica (constitucion 11) y opciones de C#. -->
  <PropertyGroup>
    <Version>2026.11.5.1</Version>
    <AssemblyVersion>2026.11.5.1</AssemblyVersion>
    <FileVersion>2026.11.5.1</FileVersion>
    <Company>Socratic</Company>
    <Product>sOC ScreenShare</Product>
    <Copyright>Copyright © 2026 Socratic</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
